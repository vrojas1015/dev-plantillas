# Variables de entorno de {{ repo_name }} para desarrollo local.
#
#   cp .env.example .env.dev    # .env.dev está en .gitignore
#
# En desarrollo (APP_ENV vacío o "development") el servicio carga .env.dev
# automáticamente, buscándolo hacia arriba desde el CWD. ENV_FILE=<ruta> fuerza
# otro archivo. En Cloud Run las variables salen de cloudrun.<env>.yaml y
# DATABASE_URL de Secret Manager.
#
# NUNCA pongas credenciales reales en este archivo: se commitea.

APP_ENV=development
SERVICE_ENV=dev
DEBUG=true
LOG_LEVEL=debug

GRPC_PORT={{ grpc_port }}

# Postgres local. Formato: postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

OTEL_SERVICE_NAME={{ repo_name }}
OTEL_RESOURCE_ATTRIBUTES=service.version=dev,deployment.environment=dev
