// ================================================================
// CreateItem
// ================================================================

func TestCreateItem_Success(t *testing.T) {
	var captured *model.Item
	repo := &mockItemRepo{
		createFn: func(_ context.Context, item *model.Item) (*model.Item, error) {
			captured = item
			return item, nil
		},
	}

	got, err := application.NewItemService(repo).CreateItem(context.Background(), application.CreateItemInput{
		Name:        "  primer item  ",
		Description: " desc ",
	})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if captured == nil {
		t.Fatal("repo.Create was not called")
	}
	if _, err := uuid.Parse(got.ID); err != nil {
		t.Errorf("ID should be a generated UUID, got %q", got.ID)
	}
	if got.Name != "primer item" {
		t.Errorf("Name should be trimmed, got %q", got.Name)
	}
	if got.Description != "desc" {
		t.Errorf("Description should be trimmed, got %q", got.Description)
	}
}

func TestCreateItem_EmptyName(t *testing.T) {
	repo := &mockItemRepo{
		createFn: func(context.Context, *model.Item) (*model.Item, error) {
			t.Fatal("repo.Create must not be called on invalid input")
			return nil, nil
		},
	}

	_, err := application.NewItemService(repo).CreateItem(context.Background(), application.CreateItemInput{Name: "   "})
	if !domainerrors.IsValidation(err) {
		t.Fatalf("expected ValidationError, got %v", err)
	}
}

func TestCreateItem_NameTooLong(t *testing.T) {
	name := strings.Repeat("a", application.ItemNameMaxLen+1)

	_, err := application.NewItemService(&mockItemRepo{}).CreateItem(context.Background(), application.CreateItemInput{Name: name})
	if !domainerrors.IsValidation(err) {
		t.Fatalf("expected ValidationError, got %v", err)
	}
}

func TestCreateItem_PropagatesConflict(t *testing.T) {
	repo := &mockItemRepo{
		createFn: func(context.Context, *model.Item) (*model.Item, error) {
			return nil, domainerrors.ConflictError("item already exists", nil)
		},
	}

	_, err := application.NewItemService(repo).CreateItem(context.Background(), application.CreateItemInput{Name: "dup"})
	if !domainerrors.IsConflict(err) {
		t.Fatalf("expected ConflictError, got %v", err)
	}
}

