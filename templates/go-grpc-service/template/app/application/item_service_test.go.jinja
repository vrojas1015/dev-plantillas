// ================================================================
// ListItems
// ================================================================

func TestListItems_DefaultLimit(t *testing.T) {
	assertListLimit(t, 0, application.DefaultPageLimit)
	assertListLimit(t, -5, application.DefaultPageLimit)
}

func TestListItems_ClampsLimit(t *testing.T) {
	assertListLimit(t, application.MaxPageLimit+1, application.MaxPageLimit)
}

func TestListItems_KeepsValidLimitAndCursor(t *testing.T) {
	var got port.ItemFilter
	repo := &mockItemRepo{
		listFn: func(_ context.Context, f port.ItemFilter) (*port.ItemPage, error) {
			got = f
			return &port.ItemPage{NextCursor: "next", HasNext: true}, nil
		},
	}

	page, err := application.NewItemService(repo).ListItems(context.Background(), port.ItemFilter{Cursor: "abc", Limit: 10})
	if err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got.Limit != 10 || got.Cursor != "abc" {
		t.Errorf("filter: got %+v", got)
	}
	if !page.HasNext || page.NextCursor != "next" {
		t.Errorf("page: got %+v", page)
	}
}

func TestListItems_PropagatesRepoError(t *testing.T) {
	repo := &mockItemRepo{
		listFn: func(context.Context, port.ItemFilter) (*port.ItemPage, error) {
			return nil, domainerrors.InternalError("failed to list items", map[string]any{"cause": "boom"})
		},
	}

	_, err := application.NewItemService(repo).ListItems(context.Background(), port.ItemFilter{})
	if !domainerrors.IsInternal(err) {
		t.Fatalf("expected InternalError, got %v", err)
	}
}

func assertListLimit(t *testing.T, in, want int32) {
	t.Helper()
	var got int32
	repo := &mockItemRepo{
		listFn: func(_ context.Context, f port.ItemFilter) (*port.ItemPage, error) {
			got = f.Limit
			return &port.ItemPage{}, nil
		},
	}
	if _, err := application.NewItemService(repo).ListItems(context.Background(), port.ItemFilter{Limit: in}); err != nil {
		t.Fatalf("unexpected error: %v", err)
	}
	if got != want {
		t.Errorf("limit %d: got %d, want %d", in, got, want)
	}
}
