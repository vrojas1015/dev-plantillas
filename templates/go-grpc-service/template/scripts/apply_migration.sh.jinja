#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Aplicar una migración a QA o PROD — {{ repo_name }}
# =============================================================================
#
# No hay migration runner ni tabla schema_migrations: los .up.sql se aplican a
# mano con psql, ANTES de que arranque el contenedor que los necesita. Este
# script usa psql en Docker (no hace falta instalar nada local).
#
# Pasos:
#   1. Prueba en seco: el .up.sql dentro de BEGIN ... ROLLBACK. Si falla, corta.
#   2. Aplica (ON_ERROR_STOP). En prod además:
#        - sin --apply solo corre la prueba en seco;
#        - con --apply pide escribir el nombre de la base (necesita terminal).
#
# Credenciales: un env-file con variables de libpq (PGHOST, PGPORT, PGUSER,
# PGPASSWORD, PGSSLMODE...). PGDATABASE se fuerza según el entorno. Las
# credenciales van del archivo a Docker y no se imprimen.
#
# Uso:
#   ./scripts/apply_migration.sh qa   000001_create_{{ db_schema }}_schema
#   ./scripts/apply_migration.sh prod 000001_create_{{ db_schema }}_schema           # solo prueba en seco
#   ./scripts/apply_migration.sh prod 000001_create_{{ db_schema }}_schema --apply   # aplica
#
# Variables:
#   DB_ENV_FILE    (default ~/.config/{{ repo_name }}/db.env) env-file de libpq
#   QA_DB_NAME     (requerida para qa)   nombre de la base de QA
#   PROD_DB_NAME   (requerida para prod) nombre de la base de prod
#   PG_IMAGE       (default postgres:16-alpine)
# =============================================================================

ENV_FILE="${DB_ENV_FILE:-$HOME/.config/{{ repo_name }}/db.env}"
PG_IMAGE="${PG_IMAGE:-postgres:16-alpine}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "Uso: $0 <qa|prod> <migración> [--apply]   (ej. 000001_create_{{ db_schema }}_schema)" >&2
  exit 1
}

ENVIRONMENT="${1:-}"
MIGRATION="${2:-}"
FLAG="${3:-}"
[[ -n "$ENVIRONMENT" && -n "$MIGRATION" ]] || usage

case "$ENVIRONMENT" in
  qa)   DATABASE="${QA_DB_NAME:?Falta QA_DB_NAME}" ; APPLY=1 ;;
  prod) DATABASE="${PROD_DB_NAME:?Falta PROD_DB_NAME}" ; APPLY=0 ;;
  *)    echo "Entorno inválido: '$ENVIRONMENT'" >&2; usage ;;
esac
case "$FLAG" in
  "") ;;
  --apply) APPLY=1 ;;
  *) echo "Flag desconocido: $FLAG" >&2; usage ;;
esac

# Acepta el nombre a secas, con .up.sql o con la ruta completa.
name="$(basename "$MIGRATION")"
name="${name%.sql}"
name="${name%.up}"
SQL_FILE="$SCRIPT_DIR/../migrations/$name.up.sql"

[[ -f "$SQL_FILE" ]] || { echo "No existe $SQL_FILE" >&2; exit 1; }
[[ -f "$ENV_FILE" ]] || { echo "No existe el env-file $ENV_FILE (ver DB_ENV_FILE)" >&2; exit 1; }

# Un BEGIN/COMMIT propio rompería la prueba en seco: el COMMIT de adentro
# persistiría antes del ROLLBACK de afuera.
if grep -qiE '^[[:space:]]*(BEGIN|COMMIT|ROLLBACK)[[:space:]]*;' "$SQL_FILE"; then
  echo "$name trae su propio BEGIN/COMMIT: no se puede probar en seco. Aplicala a mano." >&2
  exit 1
fi

# docker.exe en Windows necesita la ruta nativa del env-file.
docker_env_file="$ENV_FILE"
command -v cygpath >/dev/null 2>&1 && docker_env_file="$(cygpath -w "$ENV_FILE")"

run_psql() {
  docker run --rm -i \
    --env-file "$docker_env_file" \
    -e PGDATABASE="$DATABASE" \
    "$PG_IMAGE" \
    psql -v ON_ERROR_STOP=1 -X -q "$@"
}

echo "> $name -> $DATABASE ($ENVIRONMENT)"

echo "1/2 Prueba en seco (BEGIN ... ROLLBACK)"
{ echo "BEGIN;"; cat "$SQL_FILE"; echo; echo "ROLLBACK;"; } | run_psql
echo "    ok"

if [[ $APPLY -ne 1 ]]; then
  echo "Sin --apply: no se persistió nada. Para aplicar: $0 $ENVIRONMENT $name --apply"
  exit 0
fi

if [[ "$ENVIRONMENT" == "prod" ]]; then
  echo
  echo "Vas a aplicar $name en PROD ($DATABASE)."
  # Sin terminal el read recibe EOF: avisar en vez de cortar en silencio.
  if ! read -r -p "Escribí '$DATABASE' para confirmar: " answer; then
    echo >&2
    echo "No hay terminal para confirmar: no se aplicó nada." >&2
    exit 1
  fi
  [[ "$answer" == "$DATABASE" ]] || { echo "Cancelado." >&2; exit 1; }
fi

echo "2/2 Aplicando"
run_psql < "$SQL_FILE"
echo "$name aplicada en $DATABASE"
