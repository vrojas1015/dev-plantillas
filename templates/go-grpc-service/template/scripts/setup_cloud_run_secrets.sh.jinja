#!/usr/bin/env bash
# =============================================================================
# Setup de una sola vez por entorno — {{ repo_name }}
# =============================================================================
# Crea (idempotente): service account de runtime, roles IAM, repo de Artifact
# Registry y el secreto DATABASE_URL del entorno.
#
# Es INTERACTIVO (pide usuario/password de la DB por stdin): correlo desde una
# terminal propia, no desde un agente sin TTY.
#
# Uso:
#   CLOUD_SQL_INSTANCE=<proj:region:instancia> ./scripts/setup_cloud_run_secrets.sh qa
#   CLOUD_SQL_INSTANCE=<proj:region:instancia> ./scripts/setup_cloud_run_secrets.sh prod
#
# Variables:
#   PROJECT_ID          (default {{ gcp_project }})
#   REGION              (default {{ gcp_region }})
#   CLOUD_SQL_INSTANCE  (requerida)
# =============================================================================
set -euo pipefail

PROJECT_ID="${PROJECT_ID:-{{ gcp_project }}}"
REGION="${REGION:-{{ gcp_region }}}"
CLOUD_SQL_INSTANCE="${CLOUD_SQL_INSTANCE:?Falta CLOUD_SQL_INSTANCE (PROJECT:REGION:INSTANCE)}"
ENVIRONMENT="${1:?Uso: $0 <qa|prod>}"

case "$ENVIRONMENT" in
  qa)   SECRET_NAME="{{ service_name }}-database-url-qa" ;;
  prod) SECRET_NAME="{{ service_name }}-database-url" ;;
  *)    echo "Entorno inválido: '$ENVIRONMENT' (esperado: qa | prod)" >&2; exit 1 ;;
esac

SA_NAME="{{ repo_name }}-sa"
SA_EMAIL="${SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
AR_REPO="{{ artifact_repo }}"

echo "================================================"
echo "  Setup {{ repo_name }} -> ${ENVIRONMENT}"
echo "  Proyecto: ${PROJECT_ID}"
echo "================================================"

# 1. Service account de runtime ------------------------------------------------
echo ""
echo "Service account: ${SA_EMAIL}"
if gcloud iam service-accounts describe "${SA_EMAIL}" --project="${PROJECT_ID}" >/dev/null 2>&1; then
  echo "   Ya existe."
else
  gcloud iam service-accounts create "${SA_NAME}" \
    --display-name="{{ repo_name }} Cloud Run SA" \
    --project="${PROJECT_ID}"
  echo "   Creado. Esperando propagación IAM..."
  sleep 10
fi

# 2. Roles IAM -------------------------------------------------------------------
# cloudsql.client: conectar por el socket /cloudsql. secretAccessor: leer
# DATABASE_URL. run.invoker: llamar a otros servicios internos (quitar si no aplica).
echo ""
echo "Asignando roles IAM..."
for ROLE in \
  "roles/cloudsql.client" \
  "roles/secretmanager.secretAccessor" \
  "roles/run.invoker"; do
  echo "   + ${ROLE}"
  gcloud projects add-iam-policy-binding "${PROJECT_ID}" \
    --member="serviceAccount:${SA_EMAIL}" \
    --role="${ROLE}" \
    --condition=None \
    --quiet >/dev/null
done

# 3. Artifact Registry --------------------------------------------------------------
echo ""
echo "Artifact Registry: ${AR_REPO}"
if gcloud artifacts repositories describe "${AR_REPO}" --location="${REGION}" --project="${PROJECT_ID}" >/dev/null 2>&1; then
  echo "   Ya existe."
else
  gcloud artifacts repositories create "${AR_REPO}" \
    --repository-format=docker \
    --location="${REGION}" \
    --project="${PROJECT_ID}" \
    --description="Docker images for {{ repo_name }}"
  echo "   Creado."
fi

# 4. Secreto DATABASE_URL -------------------------------------------------------------
echo ""
echo "Secreto: ${SECRET_NAME}"
read -r -p "   DB user (vacío para omitir): " DB_USER

if [ -n "$DB_USER" ]; then
  read -r -s -p "   DB password: " DB_PASS
  echo ""
  read -r -p "   DB name: " DB_NAME
  [ -n "$DB_NAME" ] || { echo "DB name es obligatorio" >&2; exit 1; }

  urlenc() { python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"; }
  DB_USER_ENC="$(urlenc "$DB_USER")"
  DB_PASS_ENC="$(urlenc "$DB_PASS")"

  # Conexión por socket unix de Cloud SQL (annotation cloudsql-instances del cloudrun yaml).
  DB_URL="postgres://${DB_USER_ENC}:${DB_PASS_ENC}@/${DB_NAME}?host=/cloudsql/${CLOUD_SQL_INSTANCE}"
  echo "   URL: postgres://${DB_USER_ENC}:***@/${DB_NAME}?host=/cloudsql/${CLOUD_SQL_INSTANCE}"

  if ! gcloud secrets describe "${SECRET_NAME}" --project="${PROJECT_ID}" >/dev/null 2>&1; then
    gcloud secrets create "${SECRET_NAME}" --replication-policy="automatic" --project="${PROJECT_ID}"
  fi
  printf '%s' "$DB_URL" | gcloud secrets versions add "${SECRET_NAME}" --data-file=- --project="${PROJECT_ID}"
  echo "   Versión nueva del secreto guardada."
else
  echo "   Omitido. Crealo antes del primer deploy:"
  echo "     gcloud secrets create ${SECRET_NAME} --replication-policy=automatic --project=${PROJECT_ID}"
fi

echo ""
echo "================================================"
echo "  Setup completado para: ${ENVIRONMENT}"
echo "  Service account : ${SA_EMAIL}"
echo "  Secreto         : ${SECRET_NAME}"
echo "  Cloud SQL       : ${CLOUD_SQL_INSTANCE}"
echo ""
echo "  Siguiente: setup de CI/CD (docs/ci-cd-setup.md) y release por tag:"
echo "    git tag ${ENVIRONMENT}-v0.1.0 && git push origin ${ENVIRONMENT}-v0.1.0"
echo "================================================"
