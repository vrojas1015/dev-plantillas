{
  "permissions": {
    "allow": [
      "Bash(pre-commit run:*)",
      "Bash(gitleaks git:*)",
      "Bash(gitleaks dir:*)",
      "Bash(sh scripts/verificar-titulo.sh:*)"
    ],
    "deny": [
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*-adminsdk-*.json)"
    ]
  }
}
