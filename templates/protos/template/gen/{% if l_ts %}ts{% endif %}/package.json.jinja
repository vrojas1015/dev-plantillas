{
  "name": "{{ npm_package }}",
  "version": "0.1.0",
  "description": "Contratos gRPC de {{ org_name }} ({{ repo_name }}): mensajes y servicios protobuf-es v2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+{{ repo_url }}.git",
    "directory": "gen/ts"
  },
  "files": [
    "lib"
  ],
  "exports": {
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
