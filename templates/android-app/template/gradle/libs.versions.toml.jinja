# Catálogo de versiones: ÚNICA fuente de versiones del proyecto.
# Ningún build.gradle.kts escribe una versión a mano: todo sale de acá (libs.*).
#
# Compatibilidad (verificada al fijar):
#   - AGP 9.4 exige Gradle >= 9.6 (wrapper 9.7.1) y JDK 17+ (CI usa 21).
#     Kotlin integrado de AGP 9: no se aplica org.jetbrains.kotlin.android.
#   - Kotlin 2.4.21 = plugin de Compose (org.jetbrains.kotlin.plugin.compose):
#     el compilador de Compose viene con Kotlin, misma versión siempre.
#   - KSP 2.3.x es independiente de la versión de Kotlin (KSP2).
#   - detekt 1.23.8 corre con su propio Kotlin 2.0.21 (ver QualityConventionPlugin).
# Al subir una versión: ./gradlew ktlintCheck detekt lint testDebugUnitTest assembleDebug
# y un bundleProdRelease (R8) antes de mergear.

[versions]
agp = "9.4.1"
kotlin = "2.4.21"
ksp = "2.3.12"
compileSdk = "37"
targetSdk = "37"
minSdk = "{{ min_sdk }}"

androidxActivity = "1.13.0"
androidxCore = "1.19.1"
androidxDatastore = "1.2.1"
androidxHilt = "1.4.0"
androidxLifecycle = "2.11.0"
androidxNavigation = "2.10.2"
androidxProfileinstaller = "1.4.1"
androidxRoom = "2.8.5"
androidxBenchmark = "1.5.0"
androidxBaselineProfile = "1.5.0"
androidxUiautomator = "2.4.0"
androidxTestCore = "1.7.0"
androidxTestExt = "1.3.0"
androidxTestEspresso = "3.7.0"
composeBom = "2026.09.00"
hilt = "2.60.1"
kotlinxCoroutines = "1.11.0"
javaxInject = "1"
kotlinxSerialization = "1.11.0"
{%- if rest %}
ktor = "3.6.0"
okhttp = "5.5.0"
{%- endif %}
{%- if grpc %}
grpc = "1.84.2"
{%- endif %}
{%- if fb %}
firebaseBom = "35.0.0"
googleServices = "4.5.0"
firebaseCrashlyticsPlugin = "3.0.8"
{%- endif %}
playPublisher = "4.1.1"

junit4 = "4.13.2"
