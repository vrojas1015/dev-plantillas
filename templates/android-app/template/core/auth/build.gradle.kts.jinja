// Token fijo para desarrollo (sin Firebase o sin google-services.json): se lee
// de ~/.gradle/gradle.properties (devAuthToken=...), NUNCA del repo. Solo en debug.
val devAuthToken = providers.gradleProperty("devAuthToken").orElse("").get()

android {
    namespace = "{{ application_id }}.core.auth"
    buildFeatures { buildConfig = true }
    buildTypes {
        debug { buildConfigField("String", "DEV_AUTH_TOKEN", "\"$devAuthToken\"") }
        release { buildConfigField("String", "DEV_AUTH_TOKEN", "\"\"") }
    }
}

dependencies {
    api(projects.core.domain)
