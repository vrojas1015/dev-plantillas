{% raw -%}
# Tags de release:
#   qa-vX.Y.Z   -> checks + AAB firmado de QA -> pista interna de la app QA
#   prod-vX.Y.Z -> checks + AAB firmado de prod -> pista interna de prod; después,
#                  con aprobación manual (environment "produccion"), promoción a
#                  producción al 10 %. 50 % y 100 %: workflow "rollout" (manual).
# Secretos y variables: docs/ci-cd.md.
name: release

on:
  push:
    tags: ["qa-v*", "prod-v*"]

permissions:
  contents: read

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  publicar:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    environment: ${{ startsWith(github.ref_name, 'prod-') && 'prod' || 'qa' }}
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "21"
      - uses: gradle/actions/setup-gradle@v6
      - name: Versión y flavor desde el tag
        run: |
          tag="$GITHUB_REF_NAME"
          version="${tag#*-v}"
          if ! [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "::error::Tag inválido: $tag (esperado qa-vX.Y.Z o prod-vX.Y.Z)"; exit 1
          fi
          flavor=Qa; [[ "$tag" == prod-* ]] && flavor=Prod
          echo "VERSION_NAME=$version" >> "$GITHUB_ENV"
          echo "FLAVOR=$flavor" >> "$GITHUB_ENV"
      - name: Upload key y configuración (desde secretos, nunca del repo)
        env:
          UPLOAD_KEYSTORE_BASE64: ${{ secrets.ANDROID_UPLOAD_KEYSTORE_BASE64 }}
{%- endraw %}
{%- if fb %}
          GOOGLE_SERVICES_JSON_QA: ${{ '{{' }} secrets.GOOGLE_SERVICES_JSON_QA {{ '}}' }}
          GOOGLE_SERVICES_JSON_PROD: ${{ '{{' }} secrets.GOOGLE_SERVICES_JSON_PROD {{ '}}' }}
{%- endif %}
{%- raw %}
        run: |
          test -n "$UPLOAD_KEYSTORE_BASE64" || { echo "::error::Falta el secreto ANDROID_UPLOAD_KEYSTORE_BASE64"; exit 1; }
          echo "$UPLOAD_KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/upload.jks"
          echo "UPLOAD_KEYSTORE_FILE=$RUNNER_TEMP/upload.jks" >> "$GITHUB_ENV"
{%- endraw %}
{%- if fb %}
          mkdir -p app/src/qa app/src/prod
          printf '%s' "$GOOGLE_SERVICES_JSON_QA" > app/src/qa/google-services.json
          printf '%s' "$GOOGLE_SERVICES_JSON_PROD" > app/src/prod/google-services.json
{%- endif %}
{%- raw %}
      - name: Notas de la versión (CHANGELOG.md)
        run: bash scripts/release-notes.sh "$VERSION_NAME"
      - name: Checks, AAB firmado y subida a la pista interna
        env:
          UPLOAD_KEYSTORE_PASSWORD: ${{ secrets.UPLOAD_KEYSTORE_PASSWORD }}
          UPLOAD_KEY_ALIAS: ${{ secrets.UPLOAD_KEY_ALIAS }}
          UPLOAD_KEY_PASSWORD: ${{ secrets.UPLOAD_KEY_PASSWORD }}
          ANDROID_PUBLISHER_CREDENTIALS: ${{ secrets.PLAY_SERVICE_ACCOUNT_JSON }}
{%- endraw %}
{%- if grpc %}
          PROTOS_MAVEN_URL: ${{ '{{' }} vars.PROTOS_MAVEN_URL {{ '}}' }}
          PROTOS_MAVEN_TOKEN: ${{ '{{' }} secrets.PROTOS_MAVEN_TOKEN {{ '}}' }}
{%- endif %}
{%- raw %}
        run: >-
          ./gradlew ktlintCheck detekt lint testDebugUnitTest
          "bundle${FLAVOR}Release" "publish${FLAVOR}ReleaseBundle"
      - name: AAB y mapping de R8
        uses: actions/upload-artifact@v7
        with:
          name: release-${{ github.ref_name }}
          path: |
            app/build/outputs/bundle/
            app/build/outputs/mapping/
          retention-days: 30

  produccion:
    # El environment "produccion" tiene revisores obligatorios: esta es la aprobación manual.
    if: startsWith(github.ref_name, 'prod-v')
    needs: publicar
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: produccion
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "21"
      - uses: gradle/actions/setup-gradle@v6
      - name: Promover a producción al 10 %
        env:
          ANDROID_PUBLISHER_CREDENTIALS: ${{ secrets.PLAY_SERVICE_ACCOUNT_JSON }}
{%- endraw %}
{%- if grpc %}
          PROTOS_MAVEN_URL: ${{ '{{' }} vars.PROTOS_MAVEN_URL {{ '}}' }}
          PROTOS_MAVEN_TOKEN: ${{ '{{' }} secrets.PROTOS_MAVEN_TOKEN {{ '}}' }}
{%- endif %}
{%- raw %}
        run: >-
          ./gradlew promoteProdReleaseArtifact
          --from-track internal --promote-track production
          --user-fraction 0.1 --release-status inProgress
{%- endraw %}
