@Composable
internal fun ItemDetailRoute(
    onBack: () -> Unit,
    onRequestSignIn: () -> Unit,
    modifier: Modifier = Modifier,
    viewModel: ItemDetailViewModel = hiltViewModel(),
) {
    val state by viewModel.uiState.collectAsStateWithLifecycle()
    ItemDetailScreen(
        state = state,
        onBack = onBack,
        onRetry = viewModel::retry,
        onSignIn = onRequestSignIn,
        modifier = modifier,
    )
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
internal fun ItemDetailScreen(
    state: ItemDetailUiState,
    onBack: () -> Unit,
    onRetry: () -> Unit,
    onSignIn: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Scaffold(
        modifier = modifier,
        topBar = {
            TopAppBar(
                title = { Text(state.item?.name ?: stringResource(R.string.feature_items_detail_title)) },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(
                            painter = painterResource(DesignR.drawable.ic_arrow_back),
                            contentDescription = stringResource(R.string.feature_items_back),
                        )
                    }
                },
            )
        },
    ) { padding ->
        val item = state.item
        when {
            item != null -> Column(
                modifier = Modifier.fillMaxSize().padding(padding),
                verticalArrangement = Arrangement.spacedBy(8.dp),
            ) {
                state.error?.let { ErrorBanner(stringResource(R.string.feature_items_stored_data, stringResource(it.messageRes()))) }
                Text(item.name, style = MaterialTheme.typography.headlineSmall, modifier = Modifier.padding(horizontal = 16.dp))
                Text(item.description, style = MaterialTheme.typography.bodyLarge, modifier = Modifier.padding(horizontal = 16.dp))
            }

            state.error != null ->
                ErrorMessage(state.error, onRetry = onRetry, onSignIn = onSignIn, modifier = Modifier.fillMaxSize().padding(padding))

            else -> Loading(Modifier.fillMaxSize().padding(padding))
        }
    }
}
