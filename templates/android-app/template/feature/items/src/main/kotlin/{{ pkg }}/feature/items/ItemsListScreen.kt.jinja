/** Punto de entrada con el ViewModel; la pantalla en sí no conoce a Hilt (se testea sola). */
@Composable
internal fun ItemsListRoute(
    onItemClick: (String) -> Unit,
    onRequestSignIn: () -> Unit,
    modifier: Modifier = Modifier,
    viewModel: ItemsListViewModel = hiltViewModel(),
) {
    val state by viewModel.uiState.collectAsStateWithLifecycle()
    ItemsListScreen(
        state = state,
        onItemClick = onItemClick,
        onRefresh = { viewModel.onEvent(ItemsListEvent.Refresh) },
        onSignIn = onRequestSignIn,
        modifier = modifier,
    )
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
internal fun ItemsListScreen(
    state: ItemsListUiState,
    onItemClick: (String) -> Unit,
    onRefresh: () -> Unit,
    onSignIn: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Scaffold(
        modifier = modifier,
        topBar = {
            TopAppBar(
                title = { Text(stringResource(R.string.feature_items_title)) },
                actions = {
                    TextButton(onClick = onRefresh, enabled = !state.isRefreshing) {
                        Text(stringResource(R.string.feature_items_refresh))
                    }
                },
            )
        },
    ) { padding ->
        Box(modifier = Modifier.fillMaxSize().padding(padding)) {
            when {
                state.items.isEmpty() && state.isRefreshing -> Loading(Modifier.fillMaxSize())

                state.items.isEmpty() && state.error != null ->
                    ErrorMessage(error = state.error, onRetry = onRefresh, onSignIn = onSignIn, modifier = Modifier.fillMaxSize())

                state.items.isEmpty() -> Text(stringResource(R.string.feature_items_empty), Modifier.padding(16.dp))

                else -> ItemsList(state = state, onItemClick = onItemClick, onSignIn = onSignIn)
            }
        }
    }
}

@Composable
private fun ItemsList(
    state: ItemsListUiState,
    onItemClick: (String) -> Unit,
    onSignIn: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Column(modifier = modifier.fillMaxSize()) {
        if (state.showingStoredData && state.error != null) {
            val reason = stringResource(state.error.messageRes())
            ErrorBanner(text = stringResource(R.string.feature_items_stored_data, reason))
            if (state.requiresSignIn) {
                TextButton(onClick = onSignIn) { Text(stringResource(R.string.feature_items_sign_in)) }
            }
        }
        LazyColumn(modifier = Modifier.fillMaxSize()) {
            items(state.items, key = { it.id }) { item ->
                ListItem(
                    headlineContent = { Text(item.name) },
                    supportingContent = item.description.takeIf { it.isNotBlank() }?.let { { Text(it) } },
                    modifier = Modifier.clickable(onClickLabel = stringResource(R.string.feature_items_open)) {
                        onItemClick(item.id)
                    },
                )
                HorizontalDivider()
            }
        }
    }
}

