# syntax=docker/dockerfile:1
#
# Imagen del sitio de documentación para Coolify (o cualquier host de contenedores).
#
#   docker build -t docs .
#   docker run --rm -p 8080:80 docs                                   → público
#   docker run --rm -p 8080:80 -e DOCS_USUARIO=equipo -e DOCS_HASH='<hash>' docs → con basic auth
#
# El build corre `mkdocs build --strict`: un enlace roto no llega a publicarse.

# ---------------------------------------------------------------- build
FROM python:3.12-slim AS build
WORKDIR /docs

# Primero sólo las dependencias: esta capa se reutiliza mientras no cambien.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN python -m mkdocs build --strict

# ---------------------------------------------------------------- runtime
FROM caddy:2-alpine
LABEL org.opencontainers.image.title="docs"

COPY caddy/Caddyfile caddy/auth.caddy.ejemplo /etc/caddy/
COPY caddy/entrypoint.sh /usr/local/bin/docs-entrypoint.sh
COPY --from=build /docs/site /srv

# Caddy escucha HTTP plano en :80. El TLS lo termina el proxy de Coolify.
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/salud || exit 1
ENTRYPOINT ["sh", "/usr/local/bin/docs-entrypoint.sh"]
