{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "release",
  "description": "Frontmatter de contenido/releases/vX.Y.Z.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fecha",
    "servicios",
    "issues"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "X.Y.Z (el archivo es vX.Y.Z.md)"
    },
    "fecha": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Fecha absoluta AAAA-MM-DD"
    },
    "servicios": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "qa",
          "prod"
        ],
        "properties": {
          "qa": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "prod": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "description": "repo -> {qa: versión desplegada o null, prod: versión desplegada o null}"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    }
  }
}
