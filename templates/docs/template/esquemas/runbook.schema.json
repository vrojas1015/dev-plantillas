{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runbook.schema.json",
  "title": "runbook",
  "description": "Frontmatter de contenido/runbooks/<slug>.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "titulo",
    "servicios",
    "actualizado"
  ],
  "properties": {
    "titulo": {
      "type": "string",
      "minLength": 3
    },
    "servicios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "actualizado": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Fecha absoluta AAAA-MM-DD"
    }
  }
}
