# Configuración del editor, ver https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
max_line_length = off
trim_trailing_whitespace = false
