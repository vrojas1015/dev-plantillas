# Deploy del sitio a Coolify v4: imagen Docker (Caddy + site/) en GHCR + webhook.
#
#   push a main → ghcr.io/<owner>/<repo>:prod y :<sha> → Coolify
#
# El tag `prod` es el que sigue el recurso de Coolify; el del SHA es inmutable
# (rollback: apuntar el recurso a ese tag).
#
# Configuración en el GitHub Environment `production`:
#   Variables  COOLIFY_URL            https://coolify.example.com (sin barra final)
#              COOLIFY_RESOURCE_UUID  UUID del recurso en Coolify
#   Secrets    COOLIFY_TOKEN          API token de Coolify con permiso de deploy
#
# El push a GHCR usa el GITHUB_TOKEN del job (permiso packages: write).
# Setup de una vez: README.md › Deploy.
name: Deploy

on:
  push:
    branches: [main]

permissions:
  contents: read
  packages: write # push de la imagen a GHCR

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: production
    # Nunca dos deploys a la vez, y sin cancelar el que corre.
    concurrency:
      group: deploy-production
      cancel-in-progress: false
    steps:
      - uses: actions/checkout@v4

      - name: Nombre de la imagen (GHCR exige minúsculas)
        run: echo "IMAGE=ghcr.io/${GITHUB_REPOSITORY,,}" >> "$GITHUB_ENV"

      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # El Dockerfile corre `mkdocs build --strict`: un enlace roto no se publica.
      - name: Build + push de la imagen
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ${{ env.IMAGE }}:prod
            ${{ env.IMAGE }}:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Disparar deploy en Coolify
        env:
          COOLIFY_URL: ${{ vars.COOLIFY_URL }}
          COOLIFY_RESOURCE_UUID: ${{ vars.COOLIFY_RESOURCE_UUID }}
          COOLIFY_TOKEN: ${{ secrets.COOLIFY_TOKEN }}
        run: |
          for v in COOLIFY_URL COOLIFY_RESOURCE_UUID COOLIFY_TOKEN; do
            test -n "${!v}" || { echo "Falta $v en el GitHub Environment production"; exit 1; }
          done
          curl -fsS "$COOLIFY_URL/api/v1/deploy?uuid=$COOLIFY_RESOURCE_UUID&force=false" \
            -H "Authorization: Bearer $COOLIFY_TOKEN"
