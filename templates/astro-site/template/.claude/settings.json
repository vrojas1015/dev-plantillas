{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test:*)",
      "Bash(npm run verificar)",
      "Bash(npm run lighthouse)",
      "Bash(npx astro check:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase-tools deploy:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud run services replace:*)",
      "Bash(gcloud builds submit:*)",
      "Bash(git push:*)",
      "Bash(docker push:*)"
    ]
  }
}
