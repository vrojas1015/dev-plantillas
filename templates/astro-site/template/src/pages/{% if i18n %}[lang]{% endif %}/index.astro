---
// Home en los idiomas con prefijo (/en/, /pt/...). El default está en src/pages/index.astro.
import type { GetStaticPaths } from 'astro'

import { rutasDeIdiomas, type Idioma } from '@/lib/i18n'
import Inicio from '@/vistas/Inicio.astro'

export const getStaticPaths = (() => rutasDeIdiomas()) satisfies GetStaticPaths

const lang = Astro.params.lang as Idioma
---

<Inicio idioma={lang} />
