// Acceso a la colección del blog. Un post es src/content/blog/<idioma>/<slug>.md(x):
// el mismo <slug> en otra carpeta de idioma es su traducción (hreflang).
import { getCollection, type CollectionEntry } from 'astro:content'

import type { Alternativa } from '@/components/seo/Seo.astro'
import { esIdioma, idiomas, ruta, type Idioma } from '@/lib/i18n'

export type Post = CollectionEntry<'blog'>

export const slugDe = (post: Post) => post.id.split('/').slice(1).join('/')
export const idiomaDe = (post: Post) => post.id.split('/')[0] ?? ''

/** Posts publicados de un idioma, del más nuevo al más viejo. */
export async function postsDe(idioma: Idioma): Promise<Post[]> {
  const todos = await getCollection('blog', (p) => !p.data.draft && idiomaDe(p) === idioma)
  return todos.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
}

/** Idiomas que tienen al menos un post (los demás no generan índice del blog). */
export async function idiomasConPosts(): Promise<Idioma[]> {
  const todos = await getCollection('blog', (p) => !p.data.draft)
  return idiomas.filter((i) => todos.some((p) => idiomaDe(p) === i))
}

/** Versiones del post en cada idioma (para hreflang y el selector de idioma). */
export async function alternativasDe(slug: string): Promise<Alternativa[]> {
  const todos = await getCollection('blog', (p) => !p.data.draft && slugDe(p) === slug)
  return todos
    .map((p) => idiomaDe(p))
    .filter(esIdioma)
    .map((idioma) => ({ idioma, camino: ruta(idioma, `/blog/${slug}/`) }))
}

export const urlDe = (post: Post) => ruta(idiomaDe(post) as Idioma, `/blog/${slugDe(post)}/`)
