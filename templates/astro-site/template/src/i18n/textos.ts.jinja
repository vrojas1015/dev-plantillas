const textos: Record<Idioma, Record<ClaveTexto, string>> = {
{%- for i in idiomas %}
{%- if i in ['es', 'en'] %}
  {{ i }},
{%- else %}
  // TODO: traducir al «{{ i }}» (por ahora usa los textos en español).
  {{ i }}: es,
{%- endif %}
{%- endfor %}
}

export function t(idioma: Idioma, clave: ClaveTexto): string {
  return textos[idioma][clave]
}
