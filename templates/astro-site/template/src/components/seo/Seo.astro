---
// Metadatos de SEO de TODA página: lo usa el layout Base, así que ninguna página
// puede saltearlo. Reglas en docs/seo.md; scripts/verificar-seo.mjs las controla
// sobre dist/ en el CI.
import { PUBLIC_ENTORNO } from 'astro:env/client'

import { idiomaDefault, type Idioma } from '@/lib/i18n'
import { titulo as formatearTitulo, urlAbsoluta } from '@/lib/seo'
import { sitio } from '../../../sitio.config.mjs'

export interface Alternativa {
  idioma: Idioma
  camino: string
}

export interface Props {
  /** Título de la página SIN el sitio (se agrega « · Sitio»). Vacío en la home. */
  titulo?: string
  /** 70–160 caracteres, única por página. */
  descripcion: string
  /** Ruta canónica (sin dominio ni parámetros). */
  camino: string
  idioma: Idioma
  /** Versiones de esta página en cada idioma (hreflang). Incluir la propia. */
  alternativas?: Alternativa[]
  /** Imagen de Open Graph 1200×630: ruta del sitio o URL absoluta. */
  imagen?: string
  tipo?: 'website' | 'article'
  /** Fuerza noindex aun en prod (404, resultados filtrados, etc.). */
  noindex?: boolean
  publicado?: Date
  actualizado?: Date
}

const {
  titulo,
  descripcion,
  camino,
  idioma,
  alternativas = [],
  imagen = sitio.ogImagen,
  tipo = 'website',
  noindex = false,
  publicado,
  actualizado,
} = Astro.props

const tituloCompleto = formatearTitulo(titulo)
const canonica = urlAbsoluta(camino)
const imagenAbsoluta = urlAbsoluta(imagen)
// Fuera de prod (QA, previews, dev) nunca se indexa.
const robots = noindex || PUBLIC_ENTORNO !== 'prod' ? 'noindex,nofollow' : 'index,follow'
const xDefault = alternativas.find((a) => a.idioma === idiomaDefault) ?? alternativas[0]
---

<title>{tituloCompleto}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonica} />
<meta name="robots" content={robots} />
{alternativas.length > 1 && (
  <>
    {alternativas.map((a) => (
      <link rel="alternate" hreflang={a.idioma} href={urlAbsoluta(a.camino)} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={urlAbsoluta(xDefault.camino)} />}
  </>
)}

<meta property="og:site_name" content={sitio.nombre} />
<meta property="og:locale" content={idioma} />
<meta property="og:type" content={tipo} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={imagenAbsoluta} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
{actualizado && <meta property="article:modified_time" content={actualizado.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagenAbsoluta} />
