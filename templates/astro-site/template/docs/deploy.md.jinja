## Setup de GCP (una vez por proyecto: `{{ gcp_project_qa }}` y `{{ gcp_project_prod }}`)

```bash
PROJECT=<id-del-proyecto>; REPO=<grupo/repo o owner/repo>
gcloud services enable iam.googleapis.com iamcredentials.googleapis.com sts.googleapis.com \
  {% if d_fb %}firebasehosting.googleapis.com {% endif %}{% if d_cr %}run.googleapis.com cloudbuild.googleapis.com artifactregistry.googleapis.com {% endif %}--project "$PROJECT"
{%- if d_cr %}

# Artifact Registry para las imágenes
gcloud artifacts repositories create {{ repo_name }} --repository-format=docker \
  --location={{ gcp_region }} --project "$PROJECT"
{%- endif %}

# Service account de deploy
gcloud iam service-accounts create deployer-web --project "$PROJECT"
SA=deployer-web@$PROJECT.iam.gserviceaccount.com
{%- if d_fb %}
gcloud projects add-iam-policy-binding "$PROJECT" --member "serviceAccount:$SA" --role roles/firebasehosting.admin
{%- endif %}
{%- if d_cr %}
for ROL in roles/run.admin roles/cloudbuild.builds.editor roles/artifactregistry.writer \
           roles/iam.serviceAccountUser roles/storage.admin roles/serviceusage.serviceUsageConsumer; do
  gcloud projects add-iam-policy-binding "$PROJECT" --member "serviceAccount:$SA" --role "$ROL"
done
{%- endif %}

# Workload Identity Federation: el CI de ESTE repo puede impersonar al SA, sin claves
gcloud iam workload-identity-pools create ci --location=global --project "$PROJECT"
{%- if ci_gl %}
gcloud iam workload-identity-pools providers create-oidc gitlab --location=global \
  --workload-identity-pool=ci --project "$PROJECT" \
  --issuer-uri=https://gitlab.com --allowed-audiences=https://iam.googleapis.com/projects/<NÚMERO>/locations/global/workloadIdentityPools/ci/providers/gitlab \
  --attribute-mapping=google.subject=assertion.sub,attribute.project_path=assertion.project_path \
  --attribute-condition="assertion.project_path == '$REPO'"
gcloud iam service-accounts add-iam-policy-binding "$SA" --project "$PROJECT" --role roles/iam.workloadIdentityUser \
  --member "principalSet://iam.googleapis.com/projects/<NÚMERO>/locations/global/workloadIdentityPools/ci/attribute.project_path/$REPO"
{%- else %}
gcloud iam workload-identity-pools providers create-oidc github --location=global \
  --workload-identity-pool=ci --project "$PROJECT" \
  --issuer-uri=https://token.actions.githubusercontent.com \
  --attribute-mapping=google.subject=assertion.sub,attribute.repository=assertion.repository \
  --attribute-condition="assertion.repository == '$REPO'"
gcloud iam service-accounts add-iam-policy-binding "$SA" --project "$PROJECT" --role roles/iam.workloadIdentityUser \
  --member "principalSet://iam.googleapis.com/projects/<NÚMERO>/locations/global/workloadIdentityPools/ci/attribute.repository/$REPO"
{%- endif %}
```
{%- if d_cr %}

Después del **primer** deploy, hacer público el servicio (una vez; `services replace` no toca la policy):

```bash
gcloud run services add-iam-policy-binding {{ repo_name }} --region {{ gcp_region }} \
  --member allUsers --role roles/run.invoker --project "$PROJECT"
```
{%- endif %}
