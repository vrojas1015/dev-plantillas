# Cloud Run (qa) — {{ repo_name }}{% if d_fb %} (rutas SSR detrás de Firebase Hosting){% endif %}
#
# Los placeholders __X__ los reemplaza el CI con sed antes de
# `gcloud run services replace`: __PROJECT_ID__ __REGION__ __IMAGE_TAG__ __DEPLOY_TIME__
#
# El acceso público (allUsers → roles/run.invoker) se da una vez en el setup
# (docs/deploy.md); `services replace` no toca la policy.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: {{ repo_name }}
  namespace: __PROJECT_ID__
  labels:
    app: {{ repo_name }}
    env: qa
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: '0'
        autoscaling.knative.dev/maxScale: '2'
        run.googleapis.com/execution-environment: gen2
    spec:
      containerConcurrency: 80
      timeoutSeconds: 30
      containers:
        - image: __REGION__-docker.pkg.dev/__PROJECT_ID__/{{ repo_name }}/{{ repo_name }}:__IMAGE_TAG__
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: DEPLOY_TIME
              value: '__DEPLOY_TIME__'
          resources:
            limits:
              cpu: '1'
              memory: 512Mi
          startupProbe:
            httpGet:
              path: /
              port: 8080
            periodSeconds: 2
            failureThreshold: 15
  traffic:
    - percent: 100
      latestRevision: true
