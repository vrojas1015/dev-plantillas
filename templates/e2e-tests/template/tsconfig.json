{
  // Sólo para `npm run typecheck` (tsc --noEmit). Playwright y Node 24 corren
  // los .ts directamente (type stripping): nada de enums, namespaces ni
  // parameter properties (erasableSyntaxOnly), e imports con extensión .ts.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "reportes"]
}
