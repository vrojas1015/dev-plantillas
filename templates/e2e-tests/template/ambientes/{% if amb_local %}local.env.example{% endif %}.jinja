# Ambiente local de {{ repo_name }}. Este archivo va al repo: SÓLO valores no secretos.
#
# Local: copiar a ambientes/local.env (ignorado por git) y completar ahí las
# credenciales. CI: las mismas variables como variables/secretos del
# environment "local" (docs/ci.md). Lo que ya está en el entorno tiene prioridad.
#
# Correr: E2E_AMBIENTE=local npm run e2e
# Local = la plataforma levantada con docker compose (las plantillas de cada repo).
API_BASE_URL={{ api_base_url_local }}
{%- if web %}
WEB_BASE_URL={{ web_base_url_local }}
{%- endif %}
# OpenAPI del gateway (default: {{ api_gateway_openapi_url }}). Ruta /..., URL o archivo del repo.
# OPENAPI_URL=
{%- if a_fb %}

# Firebase Auth: "Web API key" del proyecto (no es secreta, pero es por ambiente).
FIREBASE_API_KEY=
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
{%- elif a_oidc %}

# OIDC: de acá sale el token_endpoint (discovery). Ver docs/usuarios-de-prueba.md.
OIDC_ISSUER={{ oidc_issuer }}
OIDC_CLIENT_ID={{ oidc_client_id }}
# OIDC_GRANT=password            # password | client_credentials
# OIDC_SCOPE=openid
# OIDC_AUDIENCE=                 # Auth0 y otros la piden en el request de token
# OIDC_TOKEN_URL=                # salta el discovery
# OIDC_CAMPO_TOKEN=access_token  # o id_token, según qué token acepte el gateway
{%- endif %}
{%- if not a_none %}

# --- Secretos: NO completar acá. En ambientes/local.env o en el CI. -----------
# Un usuario de prueba por rol (docs/usuarios-de-prueba.md). Datos sintéticos:
# nunca cuentas de personas reales.
{%- for rol in ['SIN_ROL', 'LECTOR', 'ESCRITOR', 'ADMIN'] %}
{%- if a_key %}
# E2E_{{ rol }}_API_KEY=
{%- else %}
# E2E_{{ rol }}_USUARIO=
# E2E_{{ rol }}_CLAVE=
{%- endif %}
{%- endfor %}
# Alternativa para cualquier rol: E2E_<ROL>_TOKEN con un token ya emitido.
{%- endif %}
