# Variables de entorno de {{ repo_name }} para desarrollo local.
#
#   cp .env.example .env.dev    # .env.dev está en .gitignore
#
# En desarrollo (APP_ENV vacío o "development") el gateway carga .env.dev
# automáticamente, buscándolo hacia arriba desde el CWD. ENV_FILE=<ruta> fuerza
# otro archivo.
#
# Son las MISMAS variables en todos los destinos (12-factor): docker-compose.yml
# (local){% if is_cr %}, cloudrun.<env>.yaml (secretos desde Secret Manager){% elif is_cy %}, el panel de Coolify (docker-compose.coolify.yml){% endif %}.
#
# NUNCA pongas credenciales reales en este archivo: se commitea.

APP_ENV=development
SERVICE_ENV=dev
LOG_LEVEL=debug
# json | text (default: json en production, text en el resto)
LOG_FORMAT=text

HTTP_PORT={{ http_port }}
ROUTES_FILE=routes.yaml

# --- Upstreams (uno por Name de app/upstream/registry.go) --------------------
# host:puerto del servicio gRPC. Local: el go-grpc-service corriendo en tu máquina.
UPSTREAM_ITEMS_ADDR=localhost:5000
# Transporte: local/Coolify = plaintext en red interna; Cloud Run = TLS + ID token.
UPSTREAM_TLS=false
# none | google-idtoken (solo Cloud Run; exige UPSTREAM_TLS=true)
UPSTREAM_AUTH=none
# Solo google-idtoken, si el audience no es https://<host del ADDR>:
# UPSTREAM_ITEMS_AUDIENCE=https://items-service-xxxx.a.run.app

# --- Auth: {{ auth }} -------------------------------------------------------
{%- if a_fb %}
# ID tokens de Firebase Auth: iss https://securetoken.google.com/<proyecto>, aud <proyecto>.
FIREBASE_PROJECT_ID={{ firebase_project }}
# Custom claim con los roles (setCustomUserClaims(uid, {roles: [...]})).
AUTH_ROLES_CLAIM=roles
{%- elif a_oidc %}
# Issuer EXACTO (como aparece en "iss"); se lee <issuer>/.well-known/openid-configuration.
# http:// solo se acepta con APP_ENV distinto de production.
OIDC_ISSUER={{ oidc_issuer }}
OIDC_AUDIENCE={{ oidc_audience }}
# Claim con los roles; admite rutas con puntos (Keycloak: realm_access.roles).
AUTH_ROLES_CLAIM=roles
{%- elif a_key %}
# API keys como hash SHA-256 (nunca la key en claro). Generar una:
#   go run ./cli apikey <id> <scope...>
# API_KEYS = contenido YAML/JSON (en la nube: desde un secreto), o
# API_KEYS_FILE = ruta a un archivo montado. Ejemplo de contenido:
#   keys:
#     - id: local-dev
#       sha256: <64 hex>
#       scopes: [items.read, items.write]
API_KEYS_FILE=api-keys.local.yaml
{%- else %}
# auth = ninguno: no hay credenciales; todas las rutas de routes.yaml son públicas.
{%- endif %}
{%- if a_jwt %}
# Tolerancia de reloj para exp/nbf/iat (máx. 60s).
AUTH_CLOCK_SKEW=30s
{%- endif %}

# --- CORS: orígenes EXACTOS permitidos, separados por coma (nunca *) ---------
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=false

# --- Proxies propios delante del gateway (X-Forwarded-For) -------------------
# 0 = sin proxy (local). Cloud Run / Traefik (Coolify) = 1.
TRUSTED_PROXY_HOPS=0

# --- OpenAPI en GET /openapi.json (default: true salvo en production) --------
OPENAPI_ENABLED=true

# --- Timeouts del servidor HTTP (anti-slowloris) ----------------------------
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
# Mayor que el timeout más largo de routes.yaml.
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
