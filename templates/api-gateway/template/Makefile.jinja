# Makefile de {{ repo_name }}
.DEFAULT_GOAL := help
{%- if protos_module %}

# Checkout local del repo de protos (para `make workspace`).
PROTOS_DIR ?= ../{{ protos_module.split('/')[-1] }}
{%- endif %}

BIN := bin/{{ repo_name }}
IMAGE ?= {{ repo_name }}:local
# Versiones fijadas de las herramientas de seguridad (las mismas que la CI).
GOVULNCHECK_VERSION := v1.8.0
TRIVY_IMAGE := aquasec/trivy:0.74.0

.PHONY: help run build test test-race vet fmt lint vuln tidy vendor proto image scan up down logs clean{% if protos_module %} workspace workspace-off{% endif %}{% if a_key %} apikey{% endif %}

## help: lista los targets
help:
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/^## /  /'

## run: corre el gateway local (lee .env.dev)
run:
	go run ./cli

## build: compila el binario en bin/
build:
	go build -o $(BIN) ./cli

## test: corre todos los tests (incluidos los de autorización generados desde routes.yaml)
test:
	go test ./... -count=1

## test-race: tests con el race detector (requiere cgo)
test-race:
	go test ./... -count=1 -race

## vet: go vet
vet:
	go vet ./...

## fmt: formatea el código
fmt:
	gofmt -w app cli

## lint: gofmt (check) + go vet + golangci-lint si está instalado
lint: vet
	@out="$$(gofmt -l app cli)"; if [ -n "$$out" ]; then echo "gofmt pendiente en:"; echo "$$out"; exit 1; fi
	@if command -v golangci-lint >/dev/null 2>&1; then golangci-lint run ./...; else echo "golangci-lint no instalado: solo gofmt + vet"; fi

## vuln: govulncheck (vulnerabilidades alcanzables en dependencias y stdlib)
vuln:
	go run golang.org/x/vuln/cmd/govulncheck@$(GOVULNCHECK_VERSION) ./...

## tidy: go mod tidy
tidy:
	go mod tidy

## vendor: genera vendor/ (para el build de la imagen; la CI lo genera sola)
vendor:
	go mod vendor

## proto: regenera gen/ desde proto/ (solo mientras use el proto de ejemplo local)
proto:
	buf generate

## image: construye la imagen local ($(IMAGE))
image: vendor
	docker build -t $(IMAGE) .

## scan: Trivy sobre la imagen (falla con HIGH/CRITICAL que tengan fix), igual que la CI
scan: image
	docker save -o image.tar $(IMAGE)
	docker run --rm -v "$(CURDIR):/w" $(TRIVY_IMAGE) image --input /w/image.tar \
	  --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --no-progress
	rm -f image.tar

## up: levanta el gateway con docker compose (genera vendor/ antes)
up: vendor
	docker compose up -d --build --wait

## down: baja docker compose
down:
	docker compose down

## logs: sigue los logs del gateway en docker compose
logs:
	docker compose logs -f gateway

## clean: borra binarios, vendor/ e image.tar
clean:
	rm -rf bin vendor image.tar
{%- if a_key %}

## apikey: genera una API key y su hash (ID=<id> SCOPES="a b")
apikey:
	@go run ./cli apikey $(ID) $(SCOPES)
{%- endif %}
{%- if protos_module %}

## workspace: apunta {{ protos_module }} al checkout local para co-desarrollar protos.
## go.work está en .gitignore: es una preferencia de cada dev, no del repo.
workspace:
	@test -d $(PROTOS_DIR) || { echo "No existe $(PROTOS_DIR). Clonalo al lado de este repo o pasá PROTOS_DIR=..."; exit 1; }
	go work init . $(PROTOS_DIR)
	@echo "go.work creado. 'make workspace-off' para volver al módulo publicado."

## workspace-off: descarta el workspace local
workspace-off:
	@rm -f go.work go.work.sum
	@echo "go.work eliminado. {{ protos_module }} se resuelve desde el remoto."
{%- endif %}
